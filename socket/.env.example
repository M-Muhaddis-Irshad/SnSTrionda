[TEMPLATE]
# Backend URL — the backend (Vercel) handles all DB access. The socket server
# calls backend HTTP endpoints for admin stats, activity replay, and chat
# room validation. This keeps the socket server as a pure relay with no DB.
BACKEND_URL=https://your-backend-url.vercel.app

# JWT secret (must match the backend's JWT_SECRET)
JWT_SECRET=your-secret-key

# CORS origins (comma-separated, e.g. https://sns-trionda.vercel.app,http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Internal API key — the backend uses this to authenticate internal requests
EMIT_API_KEY=your-internal-api-key

# Port (Render sets this automatically)
PORT=5001
