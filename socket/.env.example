# Database (same Neon DB as the backend)
DATABASE_URL=postgresql://...

# JWT secret (must match the backend's JWT_SECRET)
JWT_SECRET=your-secret-key

# CORS origins (comma-separated, e.g. https://sns-trionda.vercel.app,http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Internal API key — the backend uses this to authenticate emit requests
EMIT_API_KEY=your-internal-api-key

# Port (Render sets this automatically)
PORT=5001
