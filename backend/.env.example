# =============================================================================
# Trionda Backend — environment variables
# Copy to .env (backend/.env) and fill in real values. Never commit .env.
# The SAME keys (with real values) must be set on Render.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────
# Render injects PORT automatically. Local dev defaults to 5000.
PORT=5000

# Browser origins allowed to call the API and open Socket.IO connections.
# Comma-separate multiple origins: custom domain + www + Vercel + local dev.
CORS_ORIGIN=https://snwears.com,https://www.snwears.com,https://sns-trionda.vercel.app,http://localhost:3000

# ── Database (Neon/Postgres) ──────────────────────────────────────────────
# Runtime uses DATABASE_URL (Prisma Neon adapter — pooled URL recommended).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# CLI migrations (prisma migrate / db push) use the UNPOOLED direct URL.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

# ── Admin Credentials ─────────────────────────────────────────────────────
# Used by create-admin script and protected-admin role check.
ADMIN_EMAIL=s.ntriondawear7@gmail.com
ADMIN_PASSWORD=SN_WEARS09@

# ── Auth (JWT) ────────────────────────────────────────────────────────────
# Two DIFFERENT long random strings. Required — server crashes without them.
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
# Optional overrides (defaults: 15m / 7d)
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth — client id used to verify Google ID tokens server-side.
# Either name works; GOOGLE_CLIENT_ID is preferred on the backend. The value
# MUST match the client id configured in Google Cloud Console (the ID-token
# flow does not use a client secret).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Password reset emails (Resend) ────────────────────────────────────────
# From https://resend.com/api-keys. If unset the API still runs, but reset
# emails fail and are logged — the endpoint still returns 200.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender identity. "onboarding@resend.dev" only delivers to the address that
# owns the Resend account — swap in a verified domain for production.
RESEND_FROM="Trionda Wears <no-reply@snwears.com>"
# Shown in the email footer / help link.
SUPPORT_EMAIL=support@snwears.com
# Public site origin used for the reset link in emails (falls back to the
# first CORS_ORIGIN entry, e.g. https://snwears.com).
PUBLIC_SITE_URL=https://snwears.com

# ── Cloudinary (images) ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Safepay (card payments — optional) ────────────────────────────────────
# Missing keys only log a warning; COD/JazzCash/EasyPaisa still work.
SAFEPAY_SECRET_KEY=
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENV=sandbox # sandbox | production

# ── Socket.IO server (Render) ────────────────────────────────────────────
# URL of the standalone Socket.IO service on Render.
SOCKET_SERVER_URL=https://trionda-socket.onrender.com
EMIT_API_KEY=change-me-to-a-random-string
# Same key must be set on the Render socket server env.
