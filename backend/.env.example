# Server Configuration
PORT=5000

# CORS Origin (frontend dev server)
CORS_ORIGIN=http://localhost:3000

# ===========================================
# DATABASE (Neon PostgreSQL)
# ===========================================

# Pooled connection (has -pooler in hostname) — for application runtime queries
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# Direct (unpooled) connection — for Prisma CLI commands (migrations, db push)
# The hostname does NOT have -pooler in it
DATABASE_URL_UNPOOLED="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require"

# ===========================================
# JWT Authentication
# ===========================================

# Secret for signing access tokens (use a strong random string in production)
JWT_SECRET=your-access-token-secret-here

# Secret for signing refresh tokens (MUST be different from JWT_SECRET)
JWT_REFRESH_SECRET=your-refresh-token-secret-here

# Access token expiry (short-lived, e.g. 15m, 1h)
JWT_EXPIRES_IN=15m

# Refresh token expiry (long-lived, e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# FUTURE ENV VARS (add when implementing):
# ===========================================

# Cloudinary (Media Storage)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
