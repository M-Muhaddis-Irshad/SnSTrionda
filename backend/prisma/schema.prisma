// =============================================================================
// Trionda Wears — Complete Data Model
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url is configured via prisma.config.ts and the Neon adapter at runtime
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  JAZZCASH
  EASYPAISA
  COD
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Category of a site-level media asset (hero banners, collection headers, etc.)
enum SiteMediaCategory {
  HERO
  BANNER
  COLLECTION
  CAROUSEL
  CAMPAIGN
}

// =============================================================================
// PRODUCT CATALOG
// =============================================================================

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  active      Boolean    @default(true) // inactive categories are hidden from storefront
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([active])
}

model Product {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  description     String?
  basePrice       Decimal           @db.Decimal(10, 2)
  isCustomizable  Boolean           @default(false)
  isActive        Boolean           @default(true)

  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  variants        ProductVariant[]
  images          ProductImage[]
  reviews         Review[]
  discounts       Discount[]
  collectionProducts CollectionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

// =============================================================================
// DISCOUNTS (product-level sale pricing)
// =============================================================================
// A product can have at most one active discount at a time (admin-managed).
// type: PERCENT (value 0-100) or FLAT (value = PKR off the base price).
// =============================================================================

model Discount {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("PERCENT") // PERCENT | FLAT
  value     Decimal  @db.Decimal(10, 2) // percent (0-100) or flat PKR amount
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  startsAt  DateTime?
  expiresAt DateTime?
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([active])
}

// =============================================================================
// COLLECTIONS (curated product groupings with banners)
// =============================================================================

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  bannerUrl   String? // Cloudinary / site media URL for the collection header
  active      Boolean             @default(true)
  products    CollectionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  createdAt DateTime @default(now())

  @@unique([collectionId, productId])
  @@index([productId])
}

// =============================================================================
// COUPONS (promo codes — percent or flat, with limits & expiry)
// =============================================================================

model Coupon {
  id          String             @id @default(cuid())
  code        String             @unique
  description String?
  type        String             @default("PERCENT") // PERCENT | FLAT
  value       Decimal            @db.Decimal(10, 2) // percent (0-100) or flat PKR amount
  minOrder    Decimal?           @db.Decimal(10, 2) // minimum subtotal required
  maxDiscount Decimal?           @db.Decimal(10, 2) // cap for PERCENT coupons (PKR)
  usageLimit  Int?               // total number of redemptions allowed
  perUserLimit Int?              // redemptions allowed per user (default 1)
  usedCount   Int                @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  active      Boolean            @default(true)
  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([expiresAt])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String? // plain reference — avoids coupling to the Order model
  discount  Decimal  @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
}

// =============================================================================
// STORE SETTINGS (admin-editable site configuration, key/value)
// =============================================================================

model StoreSetting {
  key       String   @id
  value     String?  @db.Text
  updatedAt DateTime @updatedAt
}

// =============================================================================
// LANDING PAGE — hero slides (admin-managed banner images + details)
// =============================================================================
// Each slide is one hero/banner on the landing page: background image,
// heading text, subheading, CTA label + link, and a display order.
// =============================================================================

model HeroSlide {
  id          String   @id @default(cuid())
  heading     String
  headingAccent String?
  subheading  String?
  ctaLabel    String   @default("Shop Collection")
  ctaHref     String   @default("/shop")
  imageUrl    String?  // Cloudinary / site media URL for the banner background
  overlayGradient String? // optional CSS gradient behind the text (used when no image)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model ProductVariant {
  id              String       @id @default(cuid())
  size            String?
  color           String?
  fabricType      String?
  sku             String       @unique
  price           Decimal?     @db.Decimal(10, 2) // nullable: falls back to Product.basePrice
  stockQuantity   Int          @default(0)

  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems      OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id           String  @id @default(cuid())
  url          String  // Will be a Cloudinary URL in production
  altText      String?
  displayOrder Int     @default(0)

  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// =============================================================================
// CUSTOM MEASUREMENTS (Made-to-Order)
// =============================================================================

// Standard measurements for tailored clothing (shirts, trousers, sherwanis, etc.)
model CustomMeasurement {
  id String @id @default(cuid())

  // Upper body (shirts, sherwanis, kurtas)
  chest       Decimal?  @db.Decimal(5, 2)  // in inches
  waist       Decimal?  @db.Decimal(5, 2)
  shoulder    Decimal?  @db.Decimal(5, 2)
  sleeveLength Decimal? @db.Decimal(5, 2)
  neck        Decimal?  @db.Decimal(5, 2)

  // Lower body (trousers, shalwars)
  hip         Decimal?  @db.Decimal(5, 2)
  inseam      Decimal?  @db.Decimal(5, 2)
  thigh       Decimal?  @db.Decimal(5, 2)
  rise        Decimal?  @db.Decimal(5, 2)
  cuff        Decimal?  @db.Decimal(5, 2)

  // General
  height      Decimal?  @db.Decimal(5, 2)
  notes       String?   @db.Text  // Special instructions, fit preferences, etc.

  // Relation to OrderItem (one-to-one: each order item with measurements has one set)
  orderItem   OrderItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// USER & AUTH
// =============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials provider (hashed)
  phone         String?
  role          UserRole  @default(CUSTOMER)

  accounts        Account[]
  sessions        Session[]
  addresses       Address[]
  orders          Order[]
  activities      Activity[]
  reviews         Review[]
  notifications   Notification[]
  customerChats   ChatSession[]   @relation("chatCustomer")
  adminChats      ChatSession[]   @relation("chatAdmin")
  chatMessages    ChatMessage[]
  adminActivities AdminActivity[]
  couponRedemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// AUTH IMAGES
// =============================================================================

model AuthImage {
  id        String   @id @default(cuid())
  pageType  String   // "login" or "signup"
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id          String  @id @default(cuid())
  label       String  // e.g. "Home", "Work", "Parents' House"
  fullName    String
  phone       String
  addressLine1 String
  addressLine2 String?
  city        String
  province    String  // Province/State
  postalCode  String?
  country     String  @default("Pakistan")
  isDefault   Boolean @default(false)

  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Orders shipping to this address
  shippingOrders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// =============================================================================
// ORDERS
// =============================================================================

model Order {
  id                String          @id @default(cuid())
  orderNumber       String          @unique  // Human-readable: e.g. "TRD-2026-000001"
  status            OrderStatus     @default(PENDING)
  subtotal          Decimal         @db.Decimal(10, 2)
  shippingCost      Decimal         @db.Decimal(10, 2) @default(0)
  discount          Decimal         @default(0) @db.Decimal(10, 2)
  promoCode         String?
  total             Decimal         @db.Decimal(10, 2)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus   @default(PENDING)
  paymentSlipUrl    String?         // JazzCash payment slip (Cloudinary URL)
  paymentRejectionReason String?   // Admin rejection reason for payment slip

  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  shippingAddressId String
  shippingAddress   Address         @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)

  items             OrderItem[]
  reviews           Review[]
  statusHistory     OrderStatusHistory[]
  chatSessions      ChatSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id              String             @id @default(cuid())
  quantity        Int                @default(1)
  priceAtPurchase Decimal            @db.Decimal(10, 2) // Snapshot price at time of purchase

  orderId         String
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productVariantId String
  productVariant  ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  // Nullable: only set for made-to-order (customizable) items
  customMeasurementId String?        @unique  // One-to-one: each order item has at most one measurement set
  customMeasurement   CustomMeasurement? @relation(fields: [customMeasurementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productVariantId])
}

// =============================================================================
// ACTIVITY LOG
// =============================================================================

model Activity {
  id        String   @id @default(cuid())
  type      String   // "order", "product", "customer", "discount", "review"
  message   String
  metadata  String?  // JSON string for additional info
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// =============================================================================
// SITE MEDIA & CAMPAIGNS (admin-managed website assets)
// =============================================================================

model Image {
  id        String            @id @default(cuid())
  name      String
  url       String            // Cloudinary URL in production
  alt       String?
  category  SiteMediaCategory @default(BANNER)
  active    Boolean           @default(true)

  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active])
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageId     String
  image       Image    @relation(fields: [imageId], references: [id], onDelete: Restrict)
  startDate   DateTime
  endDate     DateTime
  discount    Int      @default(0) // percent 0-100
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([imageId])
  @@index([active])
  @@index([startDate, endDate])
}

// =============================================================================
// DELIVERY ZONES (Pakistan cities — charges & estimated delivery time)
// =============================================================================

model DeliveryZone {
  id              String   @id @default(cuid())
  name            String   @unique // e.g. "Karachi"
  latitude        Float
  longitude       Float
  deliveryCharges Int      // in PKR, e.g. 300
  estimatedDays   Int      @default(2) // 1-7
  active          Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// =============================================================================
// REVIEWS (user reviews with admin moderation workflow)
// =============================================================================
// Status flow: PENDING → APPROVED (published) | REJECTED (hidden)
// Only reviews tied to a DELIVERED order belonging to the user can be created.
// =============================================================================

model Review {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating     Int      // 1-5
  title      String?
  comment    String   @db.Text
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedAt DateTime?
  approvedBy String?  // admin user id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([status])
  @@index([userId])
}

// =============================================================================
// REAL-TIME LAYER — notifications, chat, admin activity, order status history
// =============================================================================

// Push notifications delivered to a user via Socket.IO (and persisted for the
// notifications inbox at /account/notifications).
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // ORDER_STATUS | REVIEW_STATUS | CHAT_MESSAGE | ADMIN_UPDATE
  title     String
  message   String
  data      Json?    // stores { orderId, reviewId, chatSessionId, ... } as needed
  read      Boolean  @default(false)
  readAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, read])
  @@index([createdAt])
}

// A support conversation between one customer and the admin team.
// status: OPEN | RESOLVED | CLOSED
model ChatSession {
  id         String        @id @default(cuid())
  subject    String        // e.g. "Order Issue", "Product Question"
  orderId    String?
  order      Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId String
  customer   User          @relation("chatCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  adminId    String?       // assigned admin (locks in when an admin first replies)
  admin      User?         @relation("chatAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  status     String        @default("OPEN") // OPEN | RESOLVED | CLOSED
  messages   ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([adminId])
  @@index([status])
  @@index([orderId])
}

// Individual messages inside a ChatSession.
model ChatMessage {
  id            String      @id @default(cuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message       String
  imageUrl      String?     // optional image attachment (Cloudinary URL)
  read          Boolean     @default(false)
  readAt        DateTime?

  createdAt DateTime @default(now())

  @@index([chatSessionId, createdAt])
  @@index([senderId])
}

// Audit trail of admin actions, streamed live to the admin activity feed.
// action: CREATE_PRODUCT | UPDATE_PRODUCT | DELETE_PRODUCT | UPDATE_ORDER_STATUS |
//         APPROVE_REVIEW | REJECT_REVIEW | UNAPPROVE_REVIEW | DELETE_REVIEW |
//         CREATE_DELIVERY_ZONE | UPDATE_DELIVERY_ZONE | DELETE_DELIVERY_ZONE | ...
model AdminActivity {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  entityType String   // Product | Order | Review | DeliveryZone | Chat | ...
  entityId   String
  details    Json?    // optional { fromStatus, toStatus, ... }

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([entityType])
  @@index([createdAt])
}

// =============================================================================
// BRAND STORY ("Our Story" — admin-managed homepage section)
// =============================================================================

model BrandStory {
  id        String   @id @default(cuid())
  label     String   @default("Our Story")
  heading   String
  text      String   @db.Text
  ctaLabel  String   @default("Read More")
  ctaHref   String   @default("/about")
  imageUrl  String?  // Cloudinary URL for the section image
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// NEWSLETTER SUBSCRIBERS
// =============================================================================

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
}

// Every order status transition, shown as a timeline to the customer and used
// by the admin activity feed.
model OrderStatusHistory {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          String   // PENDING | CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  statusChangedAt DateTime @default(now())
  notes           String?

  @@index([orderId])
  @@index([statusChangedAt])
}
